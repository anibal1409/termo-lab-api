PORT=3000
NODE_ENV=development

CORS_ORIGIN=http://localhost:4200
SECURE_COOKIE=false
COOKIE_SECRET=change-me-cookie-secret
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=3600
CSRF_ENABLED=false
REGISTER_ENABLED=false

# Local: DB_* explícitas. Railway: DATABASE_URL (o PG*) → se mapean a DB_* al arrancar.
# DATABASE_URL=postgresql://user:pass@host:5432/termo_lab
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=termo_lab
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

SWAGGER_PATH=api-docs
SWAGGER_USER=admin
SWAGGER_PASSWORD=change-me-swagger-password

BCRYPT_SALT_ROUNDS=10

# Login facial (sin prueba de vida en servidor; nunca aplica a admins)
FACE_LOGIN_ENABLED=false

# Proxy inverso: número de saltos o IP de confianza para req.ip (rate limiting)
TRUST_PROXY=

# Usuarios semilla (obligatorias en producción, mínimo 12 caracteres)
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=

# Correo (enlace para definir contraseña). Sin SMTP_HOST el enlace sale en el log.
# En producción: SMTP_HOST obligatorio, salvo SMTP_OPTIONAL=true (primer deploy Railway).
FRONTEND_URL=http://localhost:4200
SMTP_OPTIONAL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TermoLab <no-reply@termolab.com>"
