# Copiar valores a Variables del servicio API en Railway (no commitear secretos reales).
NODE_ENV=production
PORT=3000

# Proxy (nginx del front → API). Obligatorio detrás de Railway.
TRUST_PROXY=2

# Secretos (≥ 32 caracteres). Generar p.ej.: openssl rand -base64 48
JWT_SECRET=change-me-jwt-secret-min-32-chars-xxxx
COOKIE_SECRET=change-me-cookie-secret-min-32-chars-xx
JWT_EXPIRES_IN=3600
SECURE_COOKIE=true
CSRF_ENABLED=false
REGISTER_ENABLED=false
BCRYPT_SALT_ROUNDS=10

# URL pública HTTPS del servicio Web (nginx). Tras el primer deploy, pegar la de Railway.
FRONTEND_URL=https://tu-web.up.railway.app
CORS_ORIGIN=https://tu-web.up.railway.app

# Postgres: enlazar el plugin y usar DATABASE_URL, o mapear PG* → DB_*.
# Railway inyecta DATABASE_URL al referenciar el servicio Postgres.
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Alternativa sin DATABASE_URL (si no usas applyDatabaseEnv):
# DB_HOST=${{Postgres.PGHOST}}
# DB_PORT=${{Postgres.PGPORT}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASSWORD=${{Postgres.PGPASSWORD}}
# DB_NAME=${{Postgres.PGDATABASE}}

# Swagger Basic Auth en /api-docs
SWAGGER_PATH=api-docs
SWAGGER_USER=admin
SWAGGER_PASSWORD=change-me-swagger-password-strong

# Usuarios semilla (mín. 12 caracteres) — migraciones de seed
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_OPERATOR_PASSWORD=change-me-operator-password

# Correo: en el primer deploy puedes omitir SMTP
SMTP_OPTIONAL=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="TermoLab <no-reply@termolab.com>"

FACE_LOGIN_ENABLED=false

# Respaldos (Volume de Railway montado en /data)
BACKUP_DIR=/data/backups
